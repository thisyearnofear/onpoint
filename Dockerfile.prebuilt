# OnPoint web — prebuilt-runner deploy.
#
# The Depot remote builder OOM-kills the Next.js compile now that
# ag-studio is in the graph (exit 137 under both turbopack and webpack).
# So the production build runs locally with the same NEXT_PUBLIC_* args
# as fly.web.toml's [build.args], and this image only ships the result:
#   build/prebuilt/standalone/  <- apps/web/.next/standalone
#   build/prebuilt/static/      <- apps/web/.next/static
#   build/prebuilt/public/      <- apps/web/public
#
# Deploy:  fly deploy -c fly.web.toml --dockerfile Dockerfile.prebuilt
# Revert to `Dockerfile` once remote builders can afford the compile again.
FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production \
    PORT=8080 \
    HOSTNAME=0.0.0.0 \
    NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-9e9f819de7054860b4755c940999f1fd.r2.dev
RUN addgroup --system nodejs && adduser --system --ingroup nodejs nextjs
COPY --chown=nextjs:nodejs build/prebuilt/standalone/ ./
COPY --chown=nextjs:nodejs build/prebuilt/static/ ./apps/web/.next/static/
COPY --chown=nextjs:nodejs build/prebuilt/public/ ./apps/web/public/
USER nextjs
EXPOSE 8080
CMD ["node", "apps/web/server.js"]
