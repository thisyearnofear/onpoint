{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ],
      "env": [
        "GEMINI_API_KEY",
        "OPENAI_API_KEY",
        "SERVICE_API_KEY",
        "NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID",
        "NEXT_PUBLIC_AGENT_API_URL",
        "NEXT_PUBLIC_SENTRY_DSN",
        "NEXT_PUBLIC_POSTHOG_KEY",
        "NEXT_PUBLIC_POSTHOG_HOST"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "test": {
      "dependsOn": [
        "^build",
        "^test"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalEnv": [
    "ADMIN_EMAIL",
    "AGENT_API_INTERNAL_URL",
    "AGENT_API_URL",
    "AGENT_PRIVATE_KEY",
    "AGENT_WALLET_ADDRESS",
    "AIMLAPI_API_KEY",
    "AIML_API_BASE_URL",
    "AIML_API_KEY",
    "AIML_API_MODEL",
    "APP_BASE_URL",
    "AUTH0_BASE_URL",
    "AUTH0_DOMAIN",
    "AUTH0_MANAGEMENT_API_TOKEN",
    "AUTH0_SECRET",
    "BRIDGE_API_KEY",
    "COGNEE_API_KEY",
    "COGNEE_API_URL",
    "COGNEE_TENANT_ID",
    "DARAJA_BUSINESS_SHORTCODE",
    "DARAJA_CALLBACK_BASE_URL",
    "DARAJA_CALLBACK_SECRET",
    "DARAJA_CONSUMER_KEY",
    "DARAJA_CONSUMER_SECRET",
    "DARAJA_PASSKEY",
    "DARAJA_SANDBOX",
    "DEPLOY_PRIME_URL",
    "EXTERNAL_AGENT_URL",
    "FARCASTER_ACCOUNT_ASSOCIATION_JSON",
    "GEMINI_API_KEY",
    "JWT_SECRET",
    "NEON_DATABASE_URL",
    "NEXT_PUBLIC_AGENT_API_URL",
    "NEXT_PUBLIC_API_BASE",
    "NEXT_PUBLIC_APP_NAME",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_DEFAULT_CURRENCY",
    "NEXT_PUBLIC_DEFAULT_LOCALE",
    "NEXT_PUBLIC_MAGIC_PUBLISHABLE_KEY",
    "NEXT_PUBLIC_POSTHOG_HOST",
    "NEXT_PUBLIC_POSTHOG_KEY",
    "NEXT_PUBLIC_R2_PUBLIC_URL",
    "NEXT_PUBLIC_SENTRY_DSN",
    "NEXT_PUBLIC_URL",
    "NEXT_PUBLIC_VAPID_PUBLIC_KEY",
    "NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID",
    "NEXT_PUBLIC_ZERO_G_ENABLED",
    "NEYNAR_API_KEY",
    "NEYNAR_WEBHOOK_SECRET",
    "NODE_ENV",
    "OPENAI_API_KEY",
    "PREMIUM_USERS",
    "R2_PUBLIC_URL",
    "REPLICATE_API_TOKEN",
    "RESEND_API_KEY",
    "RESEND_FROM_EMAIL",
    "SERVICE_API_KEY",
    "STRIPE_BASIC_PRICE_ID",
    "STRIPE_CONCIERGE_PRICE_ID",
    "STRIPE_PREMIUM_PRICE_ID",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "TOKEN_SECRET",
    "TRIGGERWARE_API_KEY",
    "TRIGGERWARE_API_URL",
    "TRIGGERWARE_TRIGGER_NAME",
    "TRYON_INVITE_SECRET",
    "UPSTASH_REDIS_REST_TOKEN",
    "UPSTASH_REDIS_REST_URL",
    "URL",
    "VAPID_PRIVATE_KEY",
    "VENICE_API_KEY",
    "VERCEL_URL",
    "WA_ACCESS_TOKEN",
    "WA_PHONE_NUMBER_ID"
  ]
}
