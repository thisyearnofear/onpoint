{
  "name": "onpoint",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "check:db-migrations": "node scripts/check-db-migrations.mjs",
    "check:db-runtime": "node scripts/check-db-runtime.mjs",
    "check:live-db-schema": "node scripts/check-live-db-schema.mjs",
    "deploy:api": "bash scripts/deploy-api.sh"
  },
  "devDependencies": {
    "@img/sharp-darwin-arm64": "0.35.5",
    "@rollup/rollup-darwin-arm64": "4.67.5",
    "@types/minimatch": "3.0.5",
    "@typescript/native-preview-darwin-arm64": "7.0.0-dev.20260707.2",
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "viem": "^2.21.0"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "@types/minimatch": "3.0.5",
      "@tanstack/react-query": "5.59.20"
    }
  },
  "packageManager": "pnpm@10.10.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
