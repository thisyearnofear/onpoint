# OnPoint API Environment Variables (Production)
# Copy to .env.production on server

# Redis Configuration
# Shared cache/state backend. Optional for local development; API stateful
# flows keep a process-local fallback when Redis is unavailable.
REDIS_URL=redis://localhost:6379

# Service-to-service auth (x-service-key or Bearer). Must match the web app's
# SERVICE_API_KEY. Required in production: /api/orders/record and
# /api/status/funnel* reject requests without it.
SERVICE_API_KEY=

# Salt for the day-scoped visitor hash used by look-share analytics
# (docs/ops/growth-loop.md). Set a unique random value in production.
VISITOR_HASH_SALT=

# Neon database (required for curator/storefront, order, and try-on routes)
# API tests that cover missing configuration can run without this variable.
# Point at the live us-east-1 project (or a dev branch of it). Spike/hackathon
# demo databases never go here — they get their own var or .env file.
# (2026-11-03 lesson: a NEAR-demo project silently replaced this URL and every
# artifact route 500'd locally while prod looked fine.)
NEON_DATABASE_URL=

# Etherfuse FX API — fiat onramp (see apps/web/.env.example for full docs)
ETHERFUSE_API_KEY=
ETHERFUSE_ENV=sandbox
ETHERFUSE_DEFAULT_CHAIN=base
ETHERFUSE_DEFAULT_FIAT=MXN
ETHERFUSE_WEBHOOK_SECRET=

# Bridge Configuration (internal HTTP call)
BRIDGE_URL=http://localhost:48752

# API Server Config
PORT=48751
NODE_ENV=production

# Authentication (comma-separated user IDs)
PREMIUM_USERS=

# AI Provider Keys (required for /api/ai/* routes)
# Sandbase — PRIMARY gateway for calls OnPoint pays for itself,
# OpenAI-compatible. Key (sk-…) from https://www.sandbase.ai; model IDs are
# vendor/model from GET /v1/models, each with per-1M-token prices on its
# model card (that is how aiCost is computed here — Sandbase returns no
# cost field). Set SANDBASE_* and chat + vision go through it first.
SANDBASE_API_KEY=
# SANDBASE_BASE_URL=https://api.sandbase.ai/v1
SANDBASE_CHAT_MODEL=     # text model (e.g. a vendor/model chat id)
SANDBASE_VISION_MODEL=   # vision model — must accept image input
# SANDBASE_MODEL=          # generic fallback when the above are unset
# SANDBASE_KILL_SWITCH=0   # 1 disables all Sandbase calls
# SANDBASE_TIMEOUT_MS=20000
#
# Otari (Mozilla AI) — gateway behind Sandbase, OpenAI-compatible. Workspace
# key (otk_…) from https://otari.ai → API Keys; model IDs from the Models tab
# (format vendor/model). Still FIRST for any call where the agent sent its own
# x-otari-key, because that spend is metered in the agent's workspace, not ours.
OTARI_API_KEY=
# OTARI_BASE_URL=https://api.otari.ai/api/v1   # EU accounts: https://eu.api.otari.ai/api/v1
OTARI_CHAT_MODEL=        # text model for persona/chat calls (e.g. a catalog chat model)
OTARI_VISION_MODEL=      # vision model for image analysis (must accept image input)
# OTARI_IMAGE_MODEL=      # optional image-generation model; unset = Qwen image-gen fallback
# OTARI_MODEL=            # generic fallback when the above are unset
# OTARI_KILL_SWITCH=0     # 1 disables all Otari calls
# OTARI_TIMEOUT_MS=20000
# OTARI_ADMIN_KEY=        # master key — only for provisioning per-agent keys +
                        # scoped budgets (scripts/otari-agent-keys.mjs provision).
                        # NOT needed for inference or /api/agent/ai-usage reads.
# Agents may also pass their own key as the x-otari-key header on
# /api/ai/agent — their calls are then metered + budget-capped in
# their own Otari workspace (see /api/agent/ai-usage).
VENICE_API_KEY=
# YouCam API (Perfect Corp) — Apparel VTO provider for the paid try-on tier
# (YouCam Skin AI & Apparel VTO Hackathon). Key: https://yce.makeupar.com/api-console/en/api-keys/
# When set, paid try-ons use YouCam cloth-v4 first, falling back to Replicate
# IDM-VTON, then Venice. Leave empty to keep the Replicate-first behavior.
YOUCAM_API_KEY=
# YOUCAM_API_BASE_URL=https://yce-api-01.makeupar.com
# YOUCAM_TIMEOUT_MS=120000
GEMINI_API_KEY=
OPENAI_API_KEY=
# 0G Compute Router (0G Bridge Buildathon Wave 1)
# Bearer key from pc.0g.ai → API keys. NEVER commit a real key.
# The Router is OpenAI Chat Completions compatible:
#   https://router-api.0g.ai/v1
ZERO_G_API_KEY=
# Default model — verified vision-capable on the live catalog
ZERO_G_MODEL=qwen3-vl-30b
# Override the chat model for persona / non-vision calls
ZERO_G_CHAT_MODEL=qwen3-vl-30b
# Override the base URL for testnet routing
# ZERO_G_BASE_URL=https://router-api-testnet.integratenetwork.work/v1
# Hard timeout in ms (default 20000)
# ZERO_G_TIMEOUT_MS=20000

# Qwen Cloud (DashScope) — Qwen Cloud Hackathon, Track 4: Autopilot Agent
# Bearer key from https://home.qwencloud.com/ → API Key Management. NEVER commit.
# The API is OpenAI Chat Completions compatible:
#   https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# (use the -intl endpoint; the China endpoint dashscope.aliyuncs.com rejects
#  keys created on the international platform.)
DASHSCOPE_API_KEY=
# Default vision model — cheapest on the Qwen Cloud catalog
QWEN_CLOUD_VISION_MODEL=qwen3-vl-flash
# Default chat/text model — cheapest text model
QWEN_CLOUD_CHAT_MODEL=qwen3.6-flash
# Override the base URL (rare; defaults to the intl endpoint above)
# QWEN_CLOUD_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Hard timeout in ms (default 20000)
# QWEN_CLOUD_TIMEOUT_MS=20000
# ── Spend controls ──
# Daily budget in USD. When the in-memory counter hits this, calls throw.
# Default: 1.00. Set to 0 to disable the budget gate.
QWEN_CLOUD_DAILY_BUDGET_USD=1.00
# Kill switch — when 1, every Qwen Cloud call throws immediately.
QWEN_CLOUD_KILL_SWITCH=0

# Alibaba Cloud OSS — try-on artifact mirror
# Qwen Cloud Hackathon, Track 4: Autopilot Agent.
# This is the Proof of Alibaba Cloud Deployment required by the hackathon.
# Recommended region: oss-us-west-1 (international) to avoid China
# real-name verification. Create the bucket at:
#   https://oss.console.alibabacloud.com/
# AccessKey ID + Secret from:
#   https://ram.console.alibabacloud.com/manage/ak
ALIBABA_OSS_ACCESS_KEY_ID=
ALIBABA_OSS_ACCESS_KEY_SECRET=
ALIBABA_OSS_BUCKET=
ALIBABA_OSS_REGION=oss-us-west-1
# Optional: public CDN URL for reads (if you front the bucket with a CDN)
# ALIBABA_OSS_PUBLIC_URL=https://cdn.example.com
# Optional: override the endpoint (e.g. for an internal endpoint)
# ALIBABA_OSS_ENDPOINT=

# Signer Configuration (ADR 0001 Phase 4)
# When set, all signing is delegated to the isolated signer process.
# AGENT_PRIVATE_KEY is no longer needed in this process when SIGNER_URL is set.
SIGNER_URL=http://127.0.0.1:48753
# SIGNER_API_KEY= (required — must match the signer's value)

# Magic embedded wallet — server secret only (Express / TEE). Never commit or expose to web.
# Publishable key lives in apps/web: NEXT_PUBLIC_MAGIC_PUBLISHABLE_KEY
MAGIC_SECRET_KEY=

# Optional: Override for external services
# EXTERNAL_AGENT_URL=http://localhost:48752

# KarmaGAP — Grant & Project Management API
# Get API key at: https://gap.karmahq.xyz/
KARMA_GAP_API_KEY=
KARMA_GAP_BASE_URL=https://gapapi.karmahq.xyz/v2

# Web app base URL (used for share links, webhooks, etc.)
# Defaults to https://beonpoint.netlify.app if not set
WEB_BASE_URL=https://beonpoint.netlify.app

# x402 Facilitator (Celo gasless payments)
# Defaults to https://api.x402.celo.org if not set
X402_FACILITATOR_URL=https://api.x402.celo.org

# Replicate API (IDM-VTON physical try-on + RMBG background removal for look collages)
REPLICATE_API_TOKEN=
# REPLICATE_API_BASE_URL=https://api.replicate.com/v1

# Venice AI base URL (override for testnet/proxy)
# VENICE_BASE_URL=https://api.venice.ai/api/v1

# ── Photon Spectrum — Runway iMessage line (primary; ADR 0022) ──
# Managed iMessage line +1 (628) 264-6604 (shared pool, allow-listed senders).
# Credentials from the Photon dashboard project Settings; the spectrum-ts SDK
# also reads them automatically. The spectrum-runway worker exits without them.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Public number surfaced by /api/runway/today (defaults to the Spectrum line).
RUNWAY_LINE_NUMBER=+16282646604

# ── Linq iMessage Agent (Agentic Commerce Hackathon, Linq track — ADR 0017) ──
# Get LINQ_API_KEY from the Linq developer dashboard (Bearer token).
# LINQ_FROM_NUMBER is your Linq virtual number (sandbox: +1 424 394 5528).
# LINQ_WEBHOOK_SECRET verifies inbound webhook HMAC signatures.
#   Register the webhook URL at: https://api.onpoint.famile.xyz/linq/webhook
LINQ_API_KEY=
LINQ_FROM_NUMBER=+14243945528
# LINQ_API_BASE=https://api.linqapp.com/api/partner
LINQ_WEBHOOK_SECRET=
# Test-only escape hatch: LINQ_MOCK=1 prevents accidental live API calls.
# Never set this in production; credentials make Linq live by default.
# iMessage App identity for the OnPoint Stylist Messages extension.
# team_id: 10 uppercase alphanumeric. bundle_id: no ':'.
# TODO: replace with the real shipping extension once registered with Apple.
LINQ_APP_NAME=OnPoint Stylist
LINQ_APP_TEAM_ID=ONPOINT001
LINQ_APP_BUNDLE_ID=com.onpoint.stylist.MessageExtension

# ── Shared vision chain (Runway judging + live-session analyze routes) ──
# Redundant OpenAI-compatible vision chain. Providers are enabled only when
# their key is set: sandbase (SANDBASE_API_KEY + SANDBASE_VISION_MODEL —
# first in the default order once set), otari (OTARI_API_KEY +
# OTARI_VISION_MODEL/OTARI_MODEL), neon (both NEON_AI_BASE_URL +
# NEON_AI_API_KEY), venice (VENICE_API_KEY, above), gemini,
# openrouter, dashscope (DASHSCOPE_API_KEY, above), openai — plus modal,
# enabled by MODAL_BASE_URL alone (key optional for unauthenticated vLLM).
# NEON_AI_BASE_URL=        # Neon AI Gateway, per-branch — enable it + prepaid
#                          # credits on the project, then paste the gateway URL
# NEON_AI_API_KEY=         # Neon credential for the gateway
# VISION_NEON_MODEL=gpt-5.4-mini   # any vision-capable model on the gateway
# GEMINI_API_KEY=          # https://aistudio.google.com → API key
# OPENROUTER_API_KEY=      # https://openrouter.ai → keys
# MODAL_BASE_URL=          # e.g. https://<you>--vllm-serve.modal.run/v1
# MODAL_API_KEY=           # optional; leave unset if the endpoint is unauthenticated
# VISION_SANDBASE_MODEL=   # overrides SANDBASE_VISION_MODEL for this chain only
# VISION_OTARI_MODEL=      # overrides OTARI_VISION_MODEL for this chain only
# VISION_PROVIDERS=otari,neon,venice,gemini,openrouter,modal,dashscope,openai   # override order
# VISION_VENICE_MODEL=qwen3-vl-235b-a22b
# VISION_GEMINI_MODEL=gemini-2.5-flash
# VISION_OPENROUTER_MODEL=google/gemini-2.5-flash
# VISION_MODAL_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
# VISION_DASHSCOPE_MODEL=qwen3-vl-plus
# VISION_OPENAI_MODEL=gpt-4o-mini
# VISION_TIMEOUT_MS=90000          # per-provider timeout (reasoning models are slow)
# VISION_MAX_TOKENS=3000           # reasoning models burn tokens on CoT; keep this high
# VISION_REASONING_EFFORT=low      # OpenRouter only: low|medium|high
# RUNWAY_DAILY_VISION_CAP=500      # global daily judging calls
# RUNWAY_ROUNDS_PER_CHAT_DAY=15    # per-chat daily round cap
# RUNWAY_PLAYER_SALT=              # salts the hashed player id on funnel events

# ── Prava Agent Checkout (Agentic Commerce Hackathon — ADR 0017) ──
# Three operating modes; configure for the one in use.
#
# 1) Self-check (default — no keys set): deterministic mock fixtures. The
#    full spine (search→order→try-on→poll→checkout) is walkable without
#    any Prava credentials. Use this for local dev and judge-runnable demos.
#
# 2) Sandbox REST (sk_test_* key — the only path with a sandbox + test card):
#    Payment runs against https://sandbox.api.prava.space via REST. No real
#    money. Discovery still uses the CLI against production UCP (free).
#    Get keys at https://dashboard.prava.space.
PRAVA_SECRET_KEY=
PRAVA_PUBLISHABLE_KEY=
# PRAVA_SANDBOX_BASE=https://sandbox.api.prava.space
# PRAVA_PRODUCTION_BASE=https://api.prava.space
#
# 3) Live CLI (production, real card):
#    Install the CLI, run `prava setup --name "OnPoint"`, then set:
PRAVA_CLI_PATH=prava
PRAVA_AGENT_LINKED=0
#    NOTE: the CLI has NO sandbox host (per Prava docs); live CLI = real card.
#    Production requires temporary hackathon access (Dashboard → API Key →
#    Production → Hackathon). On production the agent is linked + AGENT_LINKED=1.
#
# (Optional, future) MCP transport instead of the CLI:
# PRAVA_MCP_URL=https://mcp.pay.prava.space/mcp
# PRAVA_MCP_TOKEN=


# ── NEAR payment rail (agent try-on / checkout, NEAR HACKATHON) ──
# Optional second rail alongside Celo cUSD. Disabled entirely when
# NEAR_USD_PRICE or a payout account is unset.
NEAR_NETWORK=testnet                    # testnet | mainnet
# NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_USD_PRICE=                         # USD per 1 NEAR — converts cUSD-priced fees to NEAR
NEAR_PAYOUT_ACCOUNT=                    # platform fallback receiver; curator commerce.nearAccountId overrides
# Optional stablecoin settlement (NEP-141 FT). When NEAR_TOKEN_CONTRACT is set,
# 402s also advertise a dollar-denominated token leg — no NEAR_USD_PRICE needed
# for that leg. NEAR_TOKEN_FORWARDER points the token leg at an escrow/forwarder
# contract (`pay` method, 0 deposit — signable by a function-call access key);
# unset → direct ft_transfer on the FT (1 yoctoNEAR, full-access key only).
# NEAR_TOKEN_CONTRACT=usdc.fakes.testnet
# NEAR_TOKEN_FORWARDER=escrow.onpoint.testnet
# NEAR_TOKEN_DECIMALS=6
# NEAR_TOKEN_SYMBOL=USDC.e
# Per-curator negotiation floor: commerce.priceFloorPct (e.g. 0.9) lets agents
# POST offerUsd on /order — below floor → 409 counter-offer, at/above → 402.
# Absent field = posted price only (no negotiation).
# ── PayPal payment rail (agent try-on / checkout, PAYPAL HACKATHON) ──
# Optional third rail alongside Celo cUSD and NEAR. Disabled entirely when
# client credentials are unset. Payments are captured to the platform
# PayPal account; curator payout is reconciled operationally.
PAYPAL_ENV=sandbox                      # sandbox | live
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=

# ── Garment cutout (optional, OFF by default) ──
# AI product-shot extraction for listings — generates a white-background
# garment cutout, stored in R2 and merged into listings.attributes.cutoutKey.
# GARMENT_CUTOUT_ENABLED=1
# OPENAI_IMAGE_API_KEY=
# OPENAI_IMAGE_BASE_URL=https://api.openai.com/v1
# OPENAI_IMAGE_MODEL=gpt-image-1
